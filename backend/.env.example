# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Credentials for the single-user UI. Generate JWT_SECRET with `openssl rand -hex 32`.
AUTH_USERNAME=
AUTH_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Create this key at https://openrouter.ai/keys. Never commit it or place it in frontend variables.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Personal Google Drive folder ID. Authenticate either with Application Default
# Credentials (gcloud auth application-default login) or a service-account key.
# Share the folder with the service account email when using a service account.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Default: 50 MiB.
MAX_AUDIO_UPLOAD_BYTES=52428800

# Cloud Run uses Linux CPU inference. The first audio request downloads this
# Whisper model unless it is already cached by the container instance.
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
