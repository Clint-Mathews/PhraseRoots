{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug PhraseRoots API",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "app.main:app",
        "--log-level",
        "debug"
      ],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Attach PhraseRoots API",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend",
          "remoteRoot": "${workspaceFolder}/backend"
        }
      ],
      "justMyCode": true
    }
  ]
}
